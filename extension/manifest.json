{
  "manifest_version": 3,
  "name": "DealerHunt — Send to DealerHunt",
  "version": "2.0.0",
  "description": "One click on any supported vehicle listing sends it to DealerHunt for an evidence-backed BUY/HOLD/PASS verdict, estimated margin, and maximum purchase price.",
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "DealerHunt"
  },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "*://*.copart.com/*",
        "*://*.iaai.com/*",
        "*://*.facebook.com/marketplace/*",
        "*://*.craigslist.org/*",
        "*://*.cars.com/*",
        "*://*.autotrader.com/*",
        "*://*.cargurus.com/*",
        "*://*.ebay.com/*",
        "*://*.carvana.com/*",
        "*://*.vroom.com/*",
        "*://*.truecar.com/*",
        "*://*.offerup.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}

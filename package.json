    "@emnapi/runtime": "1.11.3",
    "@sentry/nextjs": "11.11.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.45.0",
    "@upstash/qstash": "^2.12.1",
    "@vercel/speed-insights": "^2.1.0",
    "@zxing/browser": "0.2.1",
    "@zxing/library": "0.23.0",
    "ai": "^7.0.165",

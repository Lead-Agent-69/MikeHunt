{
  "name": "MikeHunt",
  "version": "1.0.0",
  "description": "MikeHunt — Multi-source vehicle sourcing intelligence platform",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build",
    "start": "node scripts/start-standalone.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "supabase gen types typescript --local > types/supabase.ts",
    "db:migrate": "supabase db push",
    "scraper:dev": "ts-node --project tsconfig.node.json lib/scrapers/runner.ts",
    "scraper:worker": "ts-node --project tsconfig.node.json lib/scrapers/worker.ts",
    "scraper:scheduler": "ts-node --project tsconfig.node.json lib/scrapers/scheduler.ts",
    "worker": "tsx workers/index.ts",
    "worker:dev": "tsx watch workers/index.ts",
    "worker:test": "tsx scripts/test-scraper.ts",
    "scrape:ci": "tsx scripts/scrape-ci.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "node scripts/verify.mjs",
    "verify:quick": "npm run typecheck && npm run lint",
    "accuracy:gate": "tsx scripts/valuation-backtest.ts",
    "audit:data": "tsx scripts/audit-data-quality.ts",
    "automate": "tsx scripts/automate.ts",
    "prepare": "husky",
    "postinstall": "node scripts/postinstall.js",
    "health": "node scripts/health-check.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,js,cjs,mjs,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,cjs,mjs,json,md,css}\""
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.84",
    "@ai-sdk/openai": "^4.0.79",
    "@base-ui/react": "^1.8.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@sentry/nextjs": "^11.1.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.45.0",
    "@upstash/qstash": "^2.11.3",
    "@vercel/speed-insights": "^2.0.0",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "ai": "^7.0.120",
    "axios": "^1.20.0",
    "bull": "^4.16.3",
    "bullmq": "^6.3.9",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^18.0.4",
    "framer-motion": "^13.4.4",
    "ioredis": "^6.0.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lenis": "^1.3.26",
    "lucide-react": "^1.48.0",
    "next": "^16.2.9",
    "p-limit": "^7.3.3",
    "p-retry": "^8.0.1",
    "patchright": "^1.63.0",
    "playwright": "^1.48.2",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-leaflet": "^5.0.0",
    "react-window": "^2.3.3",
    "react-window-infinite-loader": "^2.0.1",
    "resend": "^6.30.0",
    "sonner": "^2.0.8",
    "stripe": "^22.6.2",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "twilio": "^6.1.2",
    "web-push": "^3.6.7",
    "ws": "^8.22.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/bull": "^4.10.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@types/leaflet.markercluster": "^1.5.6",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.11.0",
    "eslint-config-next": "16.3.6",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "shadcn": "^4.21.0",
    "supabase": "^2.118.0",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}

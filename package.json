    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.1.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^17.0.8",
    "postcss": "^8.4.48",
    "prettier": "^3.4.2",
    "shadcn": "^4.11.0",
    "supabase": "^1.207.9",
    "tailwindcss": "^3.4.14",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}

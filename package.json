{
  "name": "dealerhunt",
  "version": "1.0.0",
  "description": "DealerHunt — Multi-source vehicle sourcing intelligence platform",
  "private": true,
  "engines": {
    "node": ">=20.18.1"
  },
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build",
    "start": "node scripts/start-standalone.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "supabase gen types typescript --local > types/supabase.ts",
    "db:migrate": "supabase db push",
    "scraper:dev": "tsx watch lib/scrapers/worker.ts",
    "scraper:worker": "tsx lib/scrapers/worker.ts",
    "scraper:scheduler": "tsx lib/scrapers/scheduler.ts",
    "worker": "tsx workers/index.ts",
    "worker:dev": "tsx watch workers/index.ts",
    "worker:test": "vitest run lib/scrapers",
    "scrape:ci": "tsx scripts/scrape-ci.ts",
    "scrape:local": "tsx scripts/scrape-local.ts",
    "sold:norfolk": "tsx scripts/sync-norfolk-sold.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:prod": "node scripts/e2e-prod.mjs",
    "perf:api": "node e2e/perf/api-p95.mjs",
    "perf:vitals": "node e2e/perf/web-vitals.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:quick": "npm run typecheck && npm run lint",
    "accuracy:gate": "tsx scripts/valuation-backtest.ts",
    "audit:data": "tsx scripts/audit-data-quality.ts",
    "audit:inventory-evidence": "tsx scripts/audit-inventory-evidence.ts",
    "automate": "tsx scripts/automate.ts",
    "prepare": "husky",
    "postinstall": "node scripts/postinstall.js",
    "health": "node scripts/health-check.mjs",
    "ops:production": "node scripts/production-watch.mjs",
    "ops:budget": "node scripts/free-tier-readiness.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,js,cjs,mjs,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,cjs,mjs,json,md,css}\""
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.99",
    "@ai-sdk/google": "^4.0.114",
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",

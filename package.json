{
  "name": "MikeHunt",
  "version": "1.0.0",
  "description": "MikeHunt — Multi-source vehicle sourcing intelligence platform",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build",
    "start": "node scripts/start-standalone.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "supabase gen types typescript --local > types/supabase.ts",
    "db:migrate": "supabase db push",
    "scraper:dev": "tsx watch lib/scrapers/worker.ts",
    "scraper:worker": "tsx lib/scrapers/worker.ts",
    "scraper:scheduler": "tsx lib/scrapers/scheduler.ts",
    "worker": "tsx workers/index.ts",
    "worker:dev": "tsx watch workers/index.ts",
    "worker:test": "vitest run lib/scrapers",
    "scrape:ci": "tsx scripts/scrape-ci.ts",
    "scrape:local": "tsx scripts/scrape-local.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "node scripts/verify.mjs",
    "verify:quick": "npm run typecheck && npm run lint",
    "accuracy:gate": "tsx scripts/valuation-backtest.ts",
    "audit:data": "tsx scripts/audit-data-quality.ts",
    "automate": "tsx scripts/automate.ts",
    "prepare": "husky",
    "postinstall": "node scripts/postinstall.js",
    "health": "node scripts/health-check.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,js,cjs,mjs,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,cjs,mjs,json,md,css}\""
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.71",
    "@ai-sdk/google": "^3.0.83",
    "@ai-sdk/openai": "^3.0.74",
    "@base-ui/react": "^1.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-select": "^2.3.1",
    "@radix-ui/react-slider": "^1.2.1",
    "@radix-ui/react-switch": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-toast": "^1.2.2",
    "@sentry/nextjs": "^10.59.0",
    "@supabase/ssr": "^0.5.1",
    "@supabase/supabase-js": "^2.45.0",
    "@upstash/qstash": "^2.11.1",
    "@vercel/speed-insights": "^2.0.0",

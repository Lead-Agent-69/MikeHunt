    "ai": "^6.0.208",
    "axios": "^1.18.0",
    "bull": "^4.16.3",
    "bullmq": "^5.79.0",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.41.0",
    "ioredis": "^5.11.1",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lenis": "^1.3.26",
    "lucide-react": "^0.454.0",
    "next": "^16.2.9",
    "p-limit": "^6.1.0",
    "p-retry": "^6.2.0",
    "patchright": "^1.61.0",
    "playwright": "^1.48.2",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-window": "^2.2.7",
    "react-window-infinite-loader": "^2.0.1",
    "resend": "^4.0.0",
    "sonner": "^2.0.7",
    "stripe": "^22.2.3",
    "swr": "^2.2.5",
    "tailwind-merge": "^2.6.1",
    "tailwindcss-animate": "^1.0.7",
    "twilio": "^6.0.2",
    "web-push": "^3.6.7",
    "ws": "^8.21.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/bull": "^4.10.0",
    "@types/leaflet": "^1.9.14",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.14.0",

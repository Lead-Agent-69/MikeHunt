    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lenis": "^1.3.27",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "p-limit": "^7.3.3",
    "p-retry": "^9.0.0",
    "patchright": "^1.64.3",
    "playwright": "^1.65.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0",
    "react-window": "^2.5.3",
    "react-window-infinite-loader": "^2.0.2",
    "resend": "^6.37.0",
    "sonner": "^2.0.8",
    "stripe": "^23.1.0",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.7.0",

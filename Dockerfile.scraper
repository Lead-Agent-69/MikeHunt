# Dockerfile.scraper — browser-capable scrape worker for the Docker fleet.
#
# Built on Node's Debian image with Playwright's browser system dependencies and xvfb (the
# Alpine app image can't run Chrome). We add Patchright's Chromium and real Google Chrome (the
# headed tier needs the actual Chrome channel to beat PerimeterX/Akamai), then loop scrape cycles under
# a virtual display.
#
#   docker compose up --scale scraper=4
#
# Reputation note: scaling replicas on ONE host shares ONE IP (doesn't help anti-bot reputation). For the
# real "unstoppable" effect, run replicas on DIFFERENT hosts/regions so each has its own IP.

FROM node:24-bookworm-slim

WORKDIR /app

# Install deps incl. devDeps (tsx/patchright live there). Force dev install in case the base sets NODE_ENV.
COPY package.json package-lock.json* ./
COPY scripts/postinstall.js ./scripts/postinstall.js
RUN HUSKY=0 npm ci --include=dev

# Install OS dependencies alongside the browsers selected by the lockfile.
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl xvfb \
    && npx playwright install --with-deps chromium chrome \
    && npx patchright install chromium \
    && rm -rf /var/lib/apt/lists/*

COPY . .

ENV NODE_ENV=production
# Turn on the headed real-Chrome tier; xvfb-run (below) gives it the display it needs.
ENV ENABLE_HEADED_SCRAPERS=1
ENV SCRAPE_INTERVAL_MS=1800000
# Do NOT bake SCRAPE_SOURCES here. The default source list lives in code
# (lib/scrapers/ci-sources.ts + sweep-schedule.ts): terms-safe sources plus
# OPERATOR_RESTORED_SOURCES (restored 2026-10-09 by operator decision; logged every run).
# SCRAPE_TERMS_SAFE_ONLY=1 at runtime turns the restored set off again.
# CACHE_PHOTOS_MAX=0 leaves deals.images as source URLs (no vehicle-photos upload).
ENV CACHE_PHOTOS_MAX=0

# Start Xvfb in the background and run the worker directly (bypasses xvfb-run signal hang when run as PID 1)
CMD ["sh", "-c", "Xvfb :99 -screen 0 1280x1024x24 -nolisten tcp -ac & export DISPLAY=:99 && npx tsx workers/scrape-worker.ts"]

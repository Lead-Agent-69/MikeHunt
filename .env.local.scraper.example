# Copy to .env.local.scraper. This file is ignored by Git; never commit real keys.
SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-project-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Start safe. Set false only after reviewing cache-only results.
CACHE_ONLY_MODE=true
FLARESOLVERR_URL=http://flaresolverr:8191/v1
REDIS_URL=redis://redis:6379
LOCAL_CACHE_PATH=/app/cache
BROWSER_PROFILE_DIR=/app/profiles
STATUS_PATH=/app/logs/status.json
SCRAPER_LOG_PATH=/app/logs/scraper.log
STATUS_PORT=8787

BATCH_SIZE=50
MAX_PARALLEL_SOURCES=3
# Free-tier Supabase budget (writes pause at 80%). ~1,000 new rows/day keeps the 60-day
# retention window near 60k rows / ~240 MB. Unchanged rows only get a cheap last_seen_at touch.
MAX_DAILY_INSERTS=1250
MAX_DAILY_UPDATES=2500
MAX_DAILY_TOUCHES=20000
HOURS_BETWEEN_RUNS=12
# Hybrid mode: buyer queue first, broad state sweep while idle.
SCRAPER_EXECUTION_MODE=hybrid
SWEEP_INTERVAL_HOURS=4
SWEEP_STATES_PER_RUN=10
SWEEP_ZIPS_PER_STATE=2
SCRAPER_JOB_TIMEOUT_MS=900000

# Optional enrichment and notification credentials
GOOGLE_GENERATIVE_AI_API_KEY=
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Optional app-compatible secrets; local scraping does not expose these over HTTP.
CRON_SECRET=replace-with-a-random-secret
INGEST_SECRET=replace-with-a-random-secret
SCRAPE_SECRET=replace-with-a-random-secret

# Optional comma-separated source IDs. By default the runner uses the curated list
# from scripts/scrape-ci.ts and skips registry-disabled or login-gated entries.
# SCRAPE_SOURCES=craigslist,carvana,copart

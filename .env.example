# Autoverse (DealerHunt) — Environment Variables

# ── SUPABASE (required) ──────────────────────────────────────────────
# Database, Auth, Realtime, Storage
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ── SCRAPER INFRA ────────────────────────────────────────────────────
# FlareSolverr bypasses Cloudflare for gated sources (Copart). Free, self-hosted.
# In GitHub Actions it runs as a service container at this URL.
FLARESOLVERR_URL=http://localhost:8191/v1
# Comma-separated source ids to scrape (blank = curated default set)
# SCRAPE_SOURCES=craigslist,cars_com
# Craigslist tuning (optional)
# CL_CITIES=dallas,houston,austin
# CL_USE_FREE_PROXY=true        # rotate free proxies if datacenter IPs get blocked

# Optional self-hosted worker (BullMQ). Only needed if running `npm run worker`.
# REDIS_URL=redis://localhost:6379
# UPSTASH_REDIS_URL=redis://default:password@endpoint:port

# ── AI (optional) ────────────────────────────────────────────────────
# Google Gemini for AI valuation / extraction (lib/ai/config.ts)
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_key

# ── NOTIFICATIONS (optional) ─────────────────────────────────────────
# Resend — email alerts (lib/notifications/email.ts)
RESEND_API_KEY=re_your_resend_key
# Sender address. Requires a verified domain in Resend. Until you verify one, leave unset and
# Resend's test sender (onboarding@resend.dev) will only deliver to your own account email.
# EMAIL_FROM=DealerHunt <alerts@yourdomain.com>
# Twilio — SMS alerts (lib/notifications/sms.ts)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# ── EXTERNAL DATA (optional) ─────────────────────────────────────────
# MarketCheck for VIN market values. If unset, valuation falls back to
# comparables from your own scraped `deals`.
# MARKETCHECK_API_KEY=your_marketcheck_key

# ── CRON / AUTOMATION ────────────────────────────────────────────────
# REQUIRED IN PRODUCTION. Protects /api/alerts/process and /api/orchestrator/run.
# Vercel Cron sends it automatically as `Authorization: Bearer <CRON_SECRET>`.
# If UNSET, all scheduled jobs (alert delivery + the scraping fallback cron) return 401 and
# silently stop. Set a long random value in your Vercel project env.
CRON_SECRET=your_random_secret_string

# Shared secret for the browser-extension ingest endpoint (/api/ingest).
# SECURE-BY-DEFAULT: if this is UNSET in production, /api/ingest is DISABLED (returns 503) to
# avoid a public write path into the deals table. Set it (and configure the extension to send
# `Authorization: Bearer <INGEST_SECRET>`) to enable ingest in prod.
INGEST_SECRET=your_random_ingest_secret
# Shared secret for the heavy /api/scrape trigger (`Authorization: Bearer <SCRAPE_SECRET>`). Falls back
# to CRON_SECRET if unset. SECURE BY DEFAULT: if neither is set, /api/scrape is CLOSED in production.
SCRAPE_SECRET=your_random_scrape_secret

# ── SENTRY (optional) ────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn
SENTRY_ORG=your_sentry_org
SENTRY_PROJECT=your_sentry_project
SENTRY_AUTH_TOKEN=your_sentry_auth_token

# ── STRIPE BILLING (optional — billing is disabled until these are set) ──
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_MONTHLY_PRICE_ID=price_...
STRIPE_PRO_PLUS_MONTHLY_PRICE_ID=price_...
STRIPE_LIFETIME_PRICE_ID=price_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# License-plate → VIN (optional Pro feature)
PLATE2VIN_KEY=

# Set to "true" at launch to enforce free-tier limits (10 deal analyses/day). Off = unmetered.
GATING_ENABLED=false

# Single admin — full access to dev/ops surfaces (developer API, status, orchestrator).
# Defaults to the owner email; override here.
ADMIN_EMAIL=shy.love.garden@gmail.com

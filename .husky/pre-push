# Local CI gate — runs the same checks as GitHub CI (typecheck + lint + tests) before any push,
# so regressions never reach main and we don't depend on GitHub Actions minutes. Kiro owns keeping
# this green (docs/handouts/KIRO.md). Bypass in a true emergency only: `git push --no-verify`.
#
# Always run against the worktree being pushed. Shared/main checkouts and husky's hooksPath can
# otherwise resolve to a stale ~/Developer/MikeHunt master tree.
ROOT="$(git rev-parse --show-toplevel)" || exit 1
cd "$ROOT" || exit 1
npm run verify

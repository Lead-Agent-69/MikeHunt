# dependencies
/node_modules
/.pnp
.pnp.js

# next.js
/.next/
/out/

# production
/build
/cache/
/.cache/
/profiles/
/logs/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files — never commit: every .env* holds live Supabase / AI / ingest secrets
.env
.env.*
!.env.example
!.env.local.scraper.example

# loose one-off scripts / debug artifacts (never commit — may contain secrets)
/scripts/apply-migrations.js
/fix-*
/test-*.js
/test-*.ts
/inspect-*
/cleanup-user.ts
/restore.py
/rewrite_*.py
/upgrade_*.py
/*-debug.*
/copart-debug.html

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase
/supabase/.temp
# config.toml is committed (no secrets) so CI can assert OAuth callback allow-list.

# playwright
/test-results/
/playwright-report/
/playwright/.cache/

# IDE
.windsurf/plans/
.devin/
.vscode/
.idea/

# logs
*.log
deploy_log.txt

# temporary migration backups (resolved, not history)
*.sql.bak

# OS
Thumbs.db
 
# local runner scripts
/*.ps1
/start_mikehunt_runners.bat

# Local visual QA captures and unpacked design assets. These are useful while
# validating a release, but are not application source or deployable assets.
/tmp-*.png
/tmp-*.jpg
/tmp-mh-logo-video/
/.tmp-mikehunt-loading-assets/
.scraper-version.json
